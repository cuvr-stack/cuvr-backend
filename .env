# Database
#DATABASE_URL=postgresql://cuvr:cuvr_secret@localhost:5432/cuvr_db
DATABASE_URL=postgresql://localhost/cuvr_db
# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=cuvr-reality-assets
USE_LOCAL_STORAGE=true

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Luma AI — Gaussian Splatting from video (lumalabs.ai/api)
LUMA_API_KEY=your-luma-api-key

# HuggingFace — Virtual Staging + Sketch Rendering (FREE — huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=

# Replicate — optional paid alternative (replicate.com)
REPLICATE_API_TOKEN=

# App
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
